{
  "name": "@genclass/demos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GenClass Runtime demo site: six small apps with a Service Worker mock server, chaos controls, scripted trials and oracles.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "node --experimental-strip-types e2e/serve.ts dist --base /genclass/ --port 4173",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "typecheck:shim": "tsc -p tsconfig.shim.json --noEmit && tsc -p tsconfig.sw.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "fetch-model": "bash scripts/fetch-model.sh public/genclass-model",
    "eval": "node --experimental-strip-types e2e/eval.ts",
    "eval:fast": "node --experimental-strip-types e2e/eval.ts --fast",
    "shots": "node --experimental-strip-types e2e/eval.ts --shots-only"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@genclass/runtime": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "redux": "^5.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "~5.9.3",
    "vite": "^8.3.3"
  }
}
